{
  "$schema": "https://developer.microsoft.com/json-schemas/sp/v2/column-formatting.schema.json",
  "elmType": "div",
  "style": { "display": "flex", "align-items": "center", "gap": "10px" },
  "children": [
    {
      "elmType": "div",
      "style": { "width": "92px", "height": "6px", "border-radius": "3px", "background-color": "#EDEFF3" },
      "children": [
        {
          "elmType": "div",
          "style": {
            "height": "6px",
            "border-radius": "3px",
            "width": "=if(@currentField >= 1, '100%', toString(Number(@currentField) * 100) + '%')",
            "background-color": "=if(@currentField >= 0.9,'#DC2B4B',if(@currentField >= 0.7,'#B4780A','#12A150'))"
          }
        }
      ]
    },
    {
      "elmType": "span",
      "style": {
        "font-size": "12px",
        "font-weight": "600",
        "color": "=if(@currentField >= 0.9,'#DC2B4B',if(@currentField >= 0.7,'#B4780A','#12A150'))"
      },
      "txtContent": "=toString(Number(@currentField) * 100) + '%'"
    }
  ]
}
